{
    "name": "syedaqeeqabbas/axcessms",
    "description": "A Laravel package for integrating the Axcess Merchant Services (AMS) payment gateway, supporting single and recurring checkout flows.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "axcess",
        "axcessms",
        "payment",
        "gateway",
        "checkout",
        "subscription",
        "recurring",
        "ecommerce"
    ],
    "authors": [
        {
            "name": "Syed Aqeeq Abbas",
            "email": "aqeeqabbas12@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9|^10|^11|^12",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "SyedAqeeqAbbas\\Axcessms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SyedAqeeqAbbas\\Axcessms\\AxcessmsServiceProvider"
            ],
            "aliases": {
                "Axcessms": "SyedAqeeqAbbas\\Axcessms\\Facades\\Axcessms"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
